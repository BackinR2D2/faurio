{
  "name": "faurio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .next-build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:check": "node scripts/check-marketplace.mjs",
    "db:media": "node scripts/sync-product-media.mjs",
    "email:check": "tsx scripts/check-email.ts",
    "email:dispatch": "tsx scripts/dispatch-email.ts",
    "email:verify": "tsx scripts/verify-smtp.ts",
    "launch:check": "tsx scripts/check-readiness.ts",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.3.0",
    "@supabase/supabase-js": "^2.78.0",
    "gsap": "^3.13.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5",
    "stripe": "^19.3.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.6.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
